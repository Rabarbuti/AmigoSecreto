# Segredos da função "sorteio" para rodar no seu computador (supabase functions serve).
# Copie este arquivo para ".env" (ele é ignorado pelo git) e ajuste.
#
# No Supabase de verdade os segredos ficam no painel (Edge Functions > Secrets) ou vêm do
# comando:  npx supabase secrets set APPS_SCRIPT_URL=... APPS_SCRIPT_SEGREDO=...

# Ponte de e-mail FALSA para testes locais (npm run ponte-falsa). O Docker enxerga o seu
# computador como "host.docker.internal".
APPS_SCRIPT_URL=http://host.docker.internal:8787/exec
APPS_SCRIPT_SEGREDO=segredo-local-de-teste-com-mais-de-vinte-caracteres
NOME_REMETENTE=Amigo Secreto (teste local)
